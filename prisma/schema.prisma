datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPERADMIN
  ADMIN
}

enum ProductStatus {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
}

enum OrderStatus {
  COMPLETED
  PENDING
  CANCELLED
}

enum TransactionType {
  PAYMENT
  PAYOUT
  REFUND
}

enum TransactionStatus {
  SUCCESS
  PROCESSING
  FAILED
}

enum CampaignStatus {
  ACTIVE
  SCHEDULED
  PAUSED
  COMPLETED
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(ADMIN)
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Store {
  id           String        @id @default(cuid())
  name         String        @default("Corelytic Store")
  slug         String        @unique @default("corelytic-store")
  currency     String        @default("USD")
  createdAt    DateTime      @default(now())
  products     Product[]
  orders       Order[]
  customers    Customer[]
  transactions Transaction[]
  goals        Goal[]
  campaigns    Campaign[]
}

model Product {
  id        String        @id @default(cuid())
  storeId   String?
  store     Store?        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name      String
  category  String        @default("General")
  price     Float
  stock     Int
  revenue   Float         @default(0)
  status    ProductStatus @default(IN_STOCK)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model Order {
  id           String      @id @default(cuid())
  storeId      String?
  store        Store?      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orderNumber  String      @unique
  customerName String
  total        Float
  status       OrderStatus @default(COMPLETED)
  createdAt    DateTime    @default(now())
}

model Customer {
  id          String   @id @default(cuid())
  storeId     String?
  store       Store?   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name        String
  email       String   @unique
  avatar      String?
  totalSpent  Float    @default(0)
  ordersCount Int      @default(1)
  status      String   @default("Active")
  country     String   @default("United States")
  lastOrderAt DateTime @default(now())
  createdAt   DateTime @default(now())
}

model Transaction {
  id            String            @id @default(cuid())
  storeId       String?
  store         Store?            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  referenceId   String            @unique
  type          TransactionType   @default(PAYMENT)
  amount        Float
  fee           Float             @default(0)
  netAmount     Float
  currency      String            @default("USD")
  paymentMethod String            @default("Stripe")
  status        TransactionStatus @default(SUCCESS)
  customerEmail String?
  description   String?
  createdAt     DateTime          @default(now())
}

model Goal {
  id          String   @id @default(cuid())
  storeId     String?
  store       Store?   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  title       String
  category    String   @default("Revenue") // Revenue, Customers, Orders, Conversion
  currentVal  Float
  targetVal   Float
  unit        String   @default("$") // "$", "users", "orders", "%"
  deadline    DateTime
  status      String   @default("ON_TRACK") // ON_TRACK, COMPLETED, BEHIND
  createdAt   DateTime @default(now())
}

model Campaign {
  id           String         @id @default(cuid())
  storeId      String?
  store        Store?         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name         String
  code         String         @unique
  discountType DiscountType   @default(PERCENTAGE)
  discountVal  Float          @default(15)
  channel      String         @default("Email Newsletter")
  budget       Float          @default(500)
  spent        Float          @default(0)
  clicks       Int            @default(0)
  conversions  Int            @default(0)
  revenue      Float          @default(0)
  startDate    DateTime       @default(now())
  endDate      DateTime?
  status       CampaignStatus @default(ACTIVE)
  createdAt    DateTime       @default(now())
}

model MetricDaily {
  id        String   @id @default(cuid())
  month     String
  order     Int      @default(0)
  income    Float
  expense   Float
  year      Int      @default(2026)
  createdAt DateTime @default(now())
}
